# Copy to .env. Everything here is optional and no secrets are needed to run Slicefall.
# Leave a line commented out to keep its default.

# SQLite database file. Default: data/slicefall.db locally, /data/slicefall.db in Docker (the
# ./data folder next to compose.yaml). In Docker keep it under /data, or scores are lost on update.
# DATABASE_URL=data/slicefall.db

# Port the server listens on. Default 5034.
# PORT=5034

# Header holding the client's IP behind a reverse proxy, used to rate-limit score submissions.
# The Docker image sets x-forwarded-for; leave it unset when nothing sits in front of the server.
# ADDRESS_HEADER=x-forwarded-for
