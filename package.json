{
  "name": "slicefall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web port of the Not Tetris 2 gameplay (physics-based falling blocks with area-based row cutting).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "server": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "node --disable-warning=ExperimentalWarning --test server/*.test.ts"
  },
  "dependencies": {
    "planck": "1.5.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
